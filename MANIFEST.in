include LICENSE
include README.md
include README.en.md
include pyproject.toml

recursive-include src/geotask_core *.py

prune benchmarks
prune build
prune dist
prune docs
prune examples
prune patent_evidence
prune schemas
prune site
prune tests
prune src/geotask_domain_packs
prune src/geotask_runtime

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
