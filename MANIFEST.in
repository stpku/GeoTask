include LICENSE
include README.md
include README.en.md
include pyproject.toml
include src/geotask_build_support.py

recursive-include src/geotask_core *.py
recursive-include schemas *.schema.json

prune benchmarks
prune build
prune dist
prune docs
prune examples
recursive-include examples/reference_agent/facility_assessment_update *.py *.md *.txt *.yaml *.json
prune patent_evidence
prune site
prune tests
prune src/geotask_domain_packs
prune src/geotask_runtime

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
