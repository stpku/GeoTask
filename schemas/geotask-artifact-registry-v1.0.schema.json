{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stpku.github.io/GeoTask/schemas/geotask-artifact-registry-v1.0.schema.json",
  "title": "GeoTask Artifact Registry v1.0",
  "description": "Machine-readable discovery contract for stable public GeoTask artifacts, their JSON Schemas, specifications, producer guidance, and validation commands.",
  "type": "object",
  "required": ["artifact_registry"],
  "additionalProperties": false,
  "properties": {
    "artifact_registry": {
      "type": "object",
      "required": [
        "schema_id",
        "registry_version",
        "artifact_count",
        "artifacts"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_id": {
          "const": "https://stpku.github.io/GeoTask/schemas/geotask-artifact-registry-v1.0.schema.json"
        },
        "registry_version": {"const": "1.0"},
        "artifact_count": {"type": "integer", "minimum": 0},
        "artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifactDescriptor"},
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "artifactDescriptor": {
      "type": "object",
      "required": [
        "artifact_id",
        "title",
        "kind",
        "schema_id",
        "schema_version",
        "schema_path",
        "specification_path",
        "ide_file_patterns",
        "wrapper_key",
        "generation_command",
        "generation_note",
        "validation_command",
        "description",
        "execution_boundary"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^geotask\\.[a-z0-9][a-z0-9.-]*$"
        },
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "kind": {
          "type": "string",
          "enum": [
            "task_document",
            "world_observation",
            "world_state_snapshot",
            "world_state_transition",
            "verification_session",
            "discrepancy_report",
            "correction_request",
            "impact_graph",
            "incremental_reevaluation_result",
            "world_state_materialization_result",
            "execution_result",
            "control_evaluation_result",
            "agent_generation_preparation_report",
            "agent_revision_verification_report",
            "agent_revision_retry_report",
            "agent_evidence_recovery_report",
            "runtime_descriptor",
            "runtime_request",
            "runtime_response",
            "core_benchmark_report",
            "artifact_validation_report"
          ]
        },
        "schema_id": {
          "type": "string",
          "format": "uri"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "schema_path": {
          "type": "string",
          "pattern": "^schemas/[A-Za-z0-9._-]+\\.schema\\.json$"
        },
        "specification_path": {
          "type": "string",
          "pattern": "^docs/spec/[A-Za-z0-9._-]+\\.md$"
        },
        "ide_file_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonEmptyString"},
          "uniqueItems": true
        },
        "wrapper_key": {
          "type": ["string", "null"]
        },
        "generation_command": {
          "type": ["string", "null"]
        },
        "generation_note": {"$ref": "#/$defs/nonEmptyString"},
        "validation_command": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"$ref": "#/$defs/nonEmptyString"},
        "execution_boundary": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  }
}
