{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stpku.github.io/GeoTask/schemas/geotask-runtime-request-v0.1.schema.json",
  "title": "GeoTask Runtime Request v0.1",
  "description": "Versioned request envelope submitted to a RuntimeAdapter after descriptor inspection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["runtime_request"],
  "properties": {
    "runtime_request": {
      "$ref": "#/$defs/request"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "artifactId": {
      "type": "string",
      "pattern": "^geotask\\.[a-z0-9][a-z0-9.-]*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "payload"],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/artifactId"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface_version",
        "request_id",
        "runtime_id",
        "operation_id",
        "input_artifacts",
        "expected_output_artifact_ids",
        "authorization_ref",
        "idempotency_key",
        "metadata"
      ],
      "properties": {
        "interface_version": {
          "const": "0.1"
        },
        "request_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "runtime_id": {
          "type": "string",
          "pattern": "^geotask\\.[a-z0-9][a-z0-9.-]*$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^geotask\\.runtime\\.[a-z0-9][a-z0-9.-]*$"
        },
        "input_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "expected_output_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifactId"
          },
          "uniqueItems": true
        },
        "authorization_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/nonEmptyString"
            }
          ]
        },
        "idempotency_key": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
