{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stpku.github.io/GeoTask/schemas/geotask-state-transition-v0.1.schema.json",
  "title": "GeoTask State Transition v0.1",
  "description": "An auditable record binding two World State snapshots to explicit path, relation, and action-eligibility changes. Schema validity does not compare snapshots, apply changes, materialize a state, verify external truth, rerun tasks, or authorize action.",
  "type": "object",
  "additionalProperties": false,
  "required": ["state_transition"],
  "properties": {
    "state_transition": {
      "$ref": "#/$defs/stateTransition"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uniqueStringArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"},
      "uniqueItems": true
    },
    "nonEmptyUniqueStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonEmptyString"},
      "uniqueItems": true
    },
    "verificationStatus": {
      "enum": [
        "asserted",
        "verified",
        "contradicted",
        "unverifiable",
        "need_data",
        "unknown"
      ]
    },
    "claimBasis": {
      "enum": [
        "direct_observation",
        "model_inference",
        "derived",
        "external_assertion",
        "human_judgment"
      ]
    },
    "stateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world_state_id",
        "revision",
        "as_of",
        "semantic_fingerprint"
      ],
      "properties": {
        "world_state_id": {"$ref": "#/$defs/nonEmptyString"},
        "revision": {"type": "integer", "minimum": 1},
        "as_of": {"$ref": "#/$defs/timestamp"},
        "semantic_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "operation",
        "path",
        "basis",
        "verification_status",
        "reason",
        "observation_refs",
        "evidence_refs"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "kind": {"enum": ["object", "attribute", "relation"]},
        "operation": {"enum": ["add", "replace", "remove"]},
        "path": {
          "type": "string",
          "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$"
        },
        "before": true,
        "after": true,
        "basis": {"$ref": "#/$defs/claimBasis"},
        "verification_status": {"$ref": "#/$defs/verificationStatus"},
        "reason": {"$ref": "#/$defs/nonEmptyString"},
        "observation_refs": {"$ref": "#/$defs/nonEmptyUniqueStringArray"},
        "evidence_refs": {"$ref": "#/$defs/uniqueStringArray"}
      },
      "allOf": [
        {
          "if": {"properties": {"operation": {"const": "add"}}, "required": ["operation"]},
          "then": {
            "required": ["after"],
            "not": {"required": ["before"]}
          }
        },
        {
          "if": {"properties": {"operation": {"const": "replace"}}, "required": ["operation"]},
          "then": {"required": ["before", "after"]}
        },
        {
          "if": {"properties": {"operation": {"const": "remove"}}, "required": ["operation"]},
          "then": {
            "required": ["before"],
            "not": {"required": ["after"]}
          }
        }
      ]
    },
    "actionEligibilityChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "output_ref",
        "before",
        "after",
        "reason",
        "observation_refs",
        "evidence_refs"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "output_ref": {"$ref": "#/$defs/nonEmptyString"},
        "before": {"enum": ["eligible", "blocked", "unknown"]},
        "after": {"enum": ["eligible", "blocked", "unknown"]},
        "reason": {"$ref": "#/$defs/nonEmptyString"},
        "observation_refs": {"$ref": "#/$defs/nonEmptyUniqueStringArray"},
        "evidence_refs": {"$ref": "#/$defs/uniqueStringArray"}
      }
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "transition_id",
        "occurred_at",
        "recorded_at",
        "from_state",
        "to_state",
        "observation_refs",
        "evidence_refs",
        "changes",
        "action_eligibility_changes"
      ],
      "properties": {
        "schema_id": {
          "const": "https://stpku.github.io/GeoTask/schemas/geotask-state-transition-v0.1.schema.json"
        },
        "schema_version": {"const": "0.1"},
        "transition_id": {"$ref": "#/$defs/nonEmptyString"},
        "occurred_at": {"$ref": "#/$defs/timestamp"},
        "recorded_at": {"$ref": "#/$defs/timestamp"},
        "from_state": {"$ref": "#/$defs/stateRef"},
        "to_state": {"$ref": "#/$defs/stateRef"},
        "observation_refs": {"$ref": "#/$defs/nonEmptyUniqueStringArray"},
        "evidence_refs": {"$ref": "#/$defs/uniqueStringArray"},
        "changes": {
          "type": "array",
          "items": {"$ref": "#/$defs/change"}
        },
        "action_eligibility_changes": {
          "type": "array",
          "items": {"$ref": "#/$defs/actionEligibilityChange"}
        }
      },
      "anyOf": [
        {"properties": {"changes": {"minItems": 1}}},
        {"properties": {"action_eligibility_changes": {"minItems": 1}}}
      ]
    }
  }
}
