{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stpku.github.io/GeoTask/schemas/geotask-verification-request-v0.1.schema.json",
  "title": "GeoTask Verification Request v0.1",
  "description": "Read-only request for one source-bound verification operation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verification_request"],
  "properties": {
    "verification_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_version",
        "request_id",
        "created_at",
        "subject",
        "input_artifacts",
        "verification_method",
        "required_capabilities",
        "allowed_provider_types",
        "assurance_profile_ref",
        "deadline",
        "external_side_effects_allowed",
        "action_authorized"
      ],
      "properties": {
        "request_version": {"const": "0.1"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "created_at": {"type": "string", "format": "date-time"},
        "subject": {"$ref": "#/$defs/subject"},
        "input_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifactBinding"}
        },
        "verification_method": {"$ref": "#/$defs/identifier"},
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_provider_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "deterministic_operator",
              "rule_engine",
              "authoritative_data_provider",
              "sensor_data_provider",
              "local_predictive_model",
              "human_review"
            ]
          }
        },
        "assurance_profile_ref": {"$ref": "#/$defs/profileRef"},
        "deadline": {"type": "string", "format": "date-time"},
        "external_side_effects_allowed": {"const": false},
        "action_authorized": {"const": false}
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_type", "value", "unit", "observed_at", "valid_until"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/identifier"},
        "claim_type": {"$ref": "#/$defs/identifier"},
        "value": {},
        "unit": {"type": ["string", "null"], "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"}
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "artifact_id", "sha256"],
      "properties": {
        "ref_id": {"$ref": "#/$defs/identifier"},
        "artifact_id": {"type": "string", "pattern": "^geotask\\.[a-z0-9][a-z0-9.-]*$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "sha256"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/identifier"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
