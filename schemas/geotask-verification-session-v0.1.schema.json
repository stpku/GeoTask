{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stpku.github.io/GeoTask/schemas/geotask-verification-session-v0.1.schema.json",
  "title": "GeoTask Verification Session v0.1",
  "description": "An immutable audit snapshot binding one World State to exact serialized task, result, control, transition, and discrepancy artifacts plus action eligibility and recheck triggers. Schema validity does not verify linked artifact semantics, execute tasks, evaluate controls, run rechecks, verify external truth, materialize state, or authorize action.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verification_session"],
  "properties": {
    "verification_session": {"$ref": "#/$defs/verificationSession"}
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uniqueStringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "nonEmptyUniqueStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "worldStateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world_state_id",
        "revision",
        "as_of",
        "semantic_fingerprint"
      ],
      "properties": {
        "world_state_id": {"$ref": "#/$defs/nonEmptyString"},
        "revision": {"type": "integer", "minimum": 1},
        "as_of": {"$ref": "#/$defs/timestamp"},
        "semantic_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "artifact_id",
        "schema_version",
        "instance_id",
        "content_sha256"
      ],
      "properties": {
        "ref_id": {"$ref": "#/$defs/nonEmptyString"},
        "artifact_id": {"$ref": "#/$defs/nonEmptyString"},
        "schema_version": {"$ref": "#/$defs/nonEmptyString"},
        "instance_id": {"$ref": "#/$defs/nonEmptyString"},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "taskRef": {
      "allOf": [
        {"$ref": "#/$defs/artifactRef"},
        {
          "type": "object",
          "properties": {
            "artifact_id": {"const": "geotask.document"},
            "schema_version": {"const": "1.0"}
          }
        }
      ]
    },
    "executionResultRef": {
      "allOf": [
        {"$ref": "#/$defs/artifactRef"},
        {
          "type": "object",
          "properties": {
            "artifact_id": {"const": "geotask.execution-result"},
            "schema_version": {"const": "1.0"}
          }
        }
      ]
    },
    "controlEvaluationRef": {
      "allOf": [
        {"$ref": "#/$defs/artifactRef"},
        {
          "type": "object",
          "properties": {
            "artifact_id": {"const": "geotask.control-evaluation"},
            "schema_version": {"const": "1.0"}
          }
        }
      ]
    },
    "stateTransitionRef": {
      "allOf": [
        {"$ref": "#/$defs/artifactRef"},
        {
          "type": "object",
          "properties": {
            "artifact_id": {"const": "geotask.state-transition"},
            "schema_version": {"const": "0.1"}
          }
        }
      ]
    },
    "discrepancyReportRef": {
      "allOf": [
        {"$ref": "#/$defs/artifactRef"},
        {
          "type": "object",
          "properties": {
            "artifact_id": {"const": "geotask.discrepancy-report"},
            "schema_version": {"const": "0.1"}
          }
        }
      ]
    },
    "actionEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_ref",
        "state",
        "reason",
        "basis_refs",
        "observation_refs"
      ],
      "properties": {
        "output_ref": {"$ref": "#/$defs/nonEmptyString"},
        "state": {"enum": ["eligible", "blocked", "unknown"]},
        "reason": {"$ref": "#/$defs/nonEmptyString"},
        "basis_refs": {"$ref": "#/$defs/nonEmptyUniqueStringArray"},
        "observation_refs": {"$ref": "#/$defs/nonEmptyUniqueStringArray"}
      }
    },
    "recheckTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "condition",
        "state",
        "reason",
        "affected_output_refs",
        "basis_refs",
        "observation_refs"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "condition": {"$ref": "#/$defs/nonEmptyString"},
        "state": {"enum": ["armed", "satisfied", "dismissed", "unknown"]},
        "reason": {"$ref": "#/$defs/nonEmptyString"},
        "affected_output_refs": {"$ref": "#/$defs/nonEmptyUniqueStringArray"},
        "basis_refs": {"$ref": "#/$defs/nonEmptyUniqueStringArray"},
        "observation_refs": {"$ref": "#/$defs/nonEmptyUniqueStringArray"}
      }
    },
    "verificationSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "session_id",
        "recorded_at",
        "state",
        "reason",
        "world_state",
        "observation_refs",
        "task_refs",
        "execution_result_refs",
        "control_evaluation_refs",
        "state_transition_refs",
        "discrepancy_refs",
        "action_eligibility",
        "recheck_triggers"
      ],
      "properties": {
        "schema_id": {
          "const": "https://stpku.github.io/GeoTask/schemas/geotask-verification-session-v0.1.schema.json"
        },
        "schema_version": {"const": "0.1"},
        "session_id": {"$ref": "#/$defs/nonEmptyString"},
        "recorded_at": {"$ref": "#/$defs/timestamp"},
        "state": {
          "enum": [
            "verified",
            "contradicted",
            "blocked",
            "need_review",
            "unknown",
            "error"
          ]
        },
        "reason": {"$ref": "#/$defs/nonEmptyString"},
        "world_state": {"$ref": "#/$defs/worldStateRef"},
        "observation_refs": {"$ref": "#/$defs/nonEmptyUniqueStringArray"},
        "task_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/taskRef"}
        },
        "execution_result_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/executionResultRef"}
        },
        "control_evaluation_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/controlEvaluationRef"}
        },
        "state_transition_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/stateTransitionRef"}
        },
        "discrepancy_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/discrepancyReportRef"}
        },
        "action_eligibility": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/actionEligibility"}
        },
        "recheck_triggers": {
          "type": "array",
          "items": {"$ref": "#/$defs/recheckTrigger"}
        }
      }
    }
  }
}
